# =============================================================
# backend/.env.example
#
# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored and must NEVER be committed.
#
# For Gmail:
#   1. Turn on 2-Step Verification on the Google account.
#   2. Create an "App Password" (Google Account > Security > App passwords).
#   3. Use the 16-character App Password below, NOT the normal login password.
# =============================================================

# ----- App -----
# Shop's local timezone. Must match the MySQL server's timezone so timestamps
# PHP writes line up with the ones MySQL writes with NOW().
APP_TIMEZONE=Asia/Manila

# ----- Email (Gmail SMTP) -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-laundry-shop@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_EMAIL=your-laundry-shop@gmail.com
MAIL_FROM_NAME=Laundry Shop

# ----- Shop details printed on receipts -----
SHOP_NAME=Laundry Shop
SHOP_ADDRESS=Your Street, Your Barangay, Your City
SHOP_PHONE=+63 900 000 0000
SHOP_EMAIL=your-laundry-shop@gmail.com
SHOP_RECEIPT_PREFIX=RCPT-

# ----- PayMongo online payments -----
# mode: test or live. Use the matching keys below.
PAYMONGO_MODE=test
# Secret key from Developers -> API Keys (sk_test_... or sk_live_...).
# Keep this on the server only. Never put it in the React app.
PAYMONGO_SECRET_KEY=
# Public key (pk_test_... / pk_live_...). Not strictly required server-side.
PAYMONGO_PUBLIC_KEY=
# Signing secret of your webhook endpoint (Developers -> Webhooks -> whsk_...).
PAYMONGO_WEBHOOK_SECRET=
# Payment methods offered on the hosted checkout page.
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,qrph
# Where PayMongo redirects the customer back to (the React app base URL).
PAYMONGO_RETURN_BASE=http://localhost:5173
# Allowed clock skew (seconds) when checking the webhook timestamp.
PAYMONGO_TIMESTAMP_TOLERANCE=300
# Local-only simulator (test mode only). Lets you exercise the full flow
# without real PayMongo keys. Keep false in production.
PAYMONGO_SIMULATE=false
